DATABASE_URL=postgresql://user:password@localhost:5432/amsafety
NEXTAUTH_SECRET=replace-with-a-long-random-string

# S3-compatible storage for uploads (avatars, etc). Uses the default AWS SDK
# credential chain (e.g. an AWS_PROFILE or instance role) rather than a
# hardcoded key/secret — see lib/aws-config.ts and lib/s3.ts.
AWS_PROFILE=default
AWS_REGION=eu-central-1
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# Web push (VAPID) keypair for browser notifications — generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Shared secret for authenticating scheduled/cron-triggered API routes
CRON_SECRET=replace-with-a-long-random-string
