def set_para_text(p, text):
    runs = p.runs
    if not runs:
        run = p.add_run(text)
        return
    runs[0].text = text
    for r in runs[1:]:
        r.text = ""


def remove_para(p):
    el = p._element
    el.getparent().remove(el)


def clone_bullet_after(anchor_p, text):
    new_el = copy.deepcopy(anchor_p._element)
    anchor_p._element.addnext(new_el)
    from docx.text.paragraph import Paragraph
    new_p = Paragraph(new_el, anchor_p._parent)
    set_para_text(new_p, text)
    return new_p


def set_cell_text(cell, text, bold=None):
    p = cell.paragraphs[0]
    for extra in cell.paragraphs[1:]:
        remove_para(extra)
    runs = p.runs
    if not runs:
        run = p.add_run(text)
        if bold is not None:
            run.bold = bold
    else:
        runs[0].text = text
        if bold is not None:
            runs[0].bold = bold
        for r in runs[1:]:
            r.text = ""


def remove_table_row(table, row):
    tbl = table._tbl
    tbl.remove(row._tr)


def insert_row_at(table, index, row):
    """Move an already-added (appended) row's XML to position `index` (0-based, counting header as 0)."""
    tbl = table._tbl
    tr = row._tr
    tbl.remove(tr)
    rows_elements = tbl.findall(qn('w:tr'))
    tbl.insert(list(tbl).index(rows_elements[index - 1]) + 1, tr)


