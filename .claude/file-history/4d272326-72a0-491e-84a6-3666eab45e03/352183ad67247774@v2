def fill_table(table, items):
    """items: list of (typ, opis). Fill existing blank data rows (rows[1:]), then
    remove any leftover blank rows, or add rows if there are more items than rows."""
    data_rows = table.rows[1:]
    n_existing = len(data_rows)
    n_items = len(items)
    for i, (typ, opis) in enumerate(items):
        if i < n_existing:
            row = data_rows[i]
        else:
            row = table.add_row()
        set_cell_text(row.cells[0], typ)
        set_cell_text(row.cells[1], opis)
    if n_items < n_existing:
        for row in data_rows[n_items:]:
            remove_table_row(table, row)


